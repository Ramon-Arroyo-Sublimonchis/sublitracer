{
  "name": "sublitracer",
  "private": true,
  "description": "VectorizarIA by Sublimonchis: vectorizador de imágenes en el navegador",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-wasm.mjs --if-stale && pnpm --filter web dev",
    "build": "pnpm build:wasm && pnpm --filter web build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench:trace": "node scripts/bench-trace.mjs",
    "deploy:zip": "pnpm build && node scripts/package-deploy.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@resvg/resvg-js": "2.6.2",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  }
}
